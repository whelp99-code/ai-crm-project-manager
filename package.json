{
  "name": "ai-crm-project-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint:self-entry": "eslint apps/web/app/login apps/web/app/self-entry apps/web/app/api/self-entry apps/web/app/self-entry-server.ts apps/web/test/self-entry-server.integration.test.ts apps/api/test/self-entry-session.security.test.ts apps/api/src/customer-work-os-v2-routes.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:security": "vitest run security",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": "9.7.0",
      "fast-uri@^3.0.0": "3.1.7",
      "fast-uri@^4.0.0": "4.1.4",
      "nanoid@^3.0.0": "3.3.18",
      "postcss": "8.5.18",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2"
    }
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "@types/node": "^22.10.2",
    "tsx": "4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
