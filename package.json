{
  "name": "ai-crm-project-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:security": "vitest run security",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": "9.7.0",
      "fast-uri@^3.0.0": "3.1.8",
      "fast-uri@^4.0.0": "4.2.1",
      "nanoid@^3.0.0": "3.3.18",
      "postcss": "8.5.28",
      "sharp": "0.35.5"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
