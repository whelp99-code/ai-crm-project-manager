# JM AI-Native Customer Work OS v2.5.0 — Ubuntu deployment
# Copy to deploy/ubuntu/.env. Never commit the real .env file.

POSTGRES_DB=ai_crm
POSTGRES_USER=ai_crm
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

RUNTIME_API_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
RUNTIME_WORKER_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
MODEL_GATEWAY_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
AUDIT_VERIFIER_DB_PASSWORD=CHANGE_ME_LONG_RANDOM

AUTH_API_KEY=CHANGE_ME_LONG_RANDOM

# Stable pilot identity. Use a UUID for workspace isolation.
WORKSPACE_ID=11111111-1111-4111-8111-111111111111
OPERATOR_PRINCIPAL_ID=owner-1

# The web service is intentionally bound to Ubuntu localhost only.
WEB_PORT=3000
WORKER_INTERVAL_MS=60000

# Optional live model. Leave MODEL_PROVIDER empty for offline/fail-closed mode.
MODEL_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_AUTH_MODE=api-key
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_ASSUME_ZERO_RETENTION=0
