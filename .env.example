# AI-CRM+Project Manager — root env template (apps/api, apps/worker)
#
# Copy to `.env` for local use; never commit real values. See
# docs/ops/runtime-dsn.md for the full runtime-role DSN contract and
# docs/ops/authn.md / docs/ops/finance-pack-pilot.md for the auth/finance
# fail-closed contracts these values gate.

# --- Database (G-01/G-05 role separation) ---------------------------------

# Runtime-role DSN: the connection the request path uses for scoped
# per-workspace reads/writes (RLS-enforced via `SET LOCAL app.workspace_id`).
# MUST point at the `ai_crm_runtime_api` role, which is NOBYPASSRLS — see
# packages/persistence/scripts/pg-rls-smoke.sh, which proves this role's
# workspace isolation live against the docker `ai_crm` database.
# DATABASE_URL=postgres://ai_crm_runtime_api:CHANGE_ME@localhost:5432/ai_crm

# Admin DSN (G-01 MEDIUM 4 role separation): used ONLY for hydrate-on-boot
# cross-workspace admin reads (listAllControls / listAllIntents /
# listJobSnapshots()) in apps/api, and for the same cross-workspace admin
# reads/writes (listAllControls / listAllIntents / outbox drain) plus
# scoping apps/worker's DATABASE_URL to per-workspace saveIntent only — see
# docs/ops/worker.md. This role legitimately bypasses RLS by design — point
# it at a role such as `ai_crm` (superuser/bootstrap) or a dedicated admin
# role, never the per-request runtime pool's own credentials. Falls back to
# DATABASE_URL when unset (dev-only fallback; see docs/ops/sor-persistence.md
# and docs/ops/worker.md).
# ADMIN_DATABASE_URL=postgres://ai_crm:CHANGE_ME@localhost:5432/ai_crm

# Model-gateway DSN (Q2 / D2, ADR-010 disjoint-principal role separation):
# used ONLY for model_invocations reads/writes in apps/api. MUST point at
# the ai_crm_runtime_model_gateway role — write grants were deliberately
# moved off ai_crm_runtime_api/ai_crm_runtime_worker onto this role (see
# 0002_model_gateway_and_break_glass_roles.sql, docs/adr/010-model-gateway.md,
# docs/security/rls-role-model.md). Falls back to DATABASE_URL when unset
# (dev/CI-only fallback; see docs/ops/sor-persistence.md). PRODUCTION IS
# FAIL-CLOSED: with NODE_ENV=production and a model provider configured,
# createApp refuses to start ([MODEL_GATEWAY_DSN_REQUIRED_IN_PROD]) unless
# this is set to a DSN DISTINCT from DATABASE_URL — the same-DSN fallback
# would collapse the ADR-010 boundary in production. Only set
# ALLOW_INSECURE_PROD=1 for an audited same-DSN bring-up.
# MODEL_GATEWAY_DATABASE_URL=postgres://ai_crm_runtime_model_gateway:CHANGE_ME@localhost:5432/ai_crm

# --- Auth (T-017 / G-05 fail-closed) ---------------------------------------

# Shared API key required on mutating /api/* and all /api/agent/* routes.
# Production MUST set one of AUTH_API_KEY / API_AUTH_TOKEN — without one,
# createApp() throws [AUTH_REQUIRED_IN_PROD] and refuses to start unless
# ALLOW_INSECURE_PROD=1 is explicitly approved for an audited insecure
# bring-up. Only non-production keeps the dev header-principal mode by default.
# AUTH_API_KEY=CHANGE_ME
# API_AUTH_TOKEN=CHANGE_ME

# CWOS v2 pilot operator binding. Production API-key mode refuses to boot
# unless all three are set with AUTH_API_KEY/API_AUTH_TOKEN.
# The server binds that authenticated key to exactly one human principal and
# workspace. Requests must echo matching identity headers, x-step-up is rejected,
# and step-up authority comes only from this server-side deployment setting.
# CWOS_V2_OPERATOR_WORKSPACE_ID=CHANGE_ME_UUID
# CWOS_V2_OPERATOR_PRINCIPAL_ID=CHANGE_ME_PRINCIPAL
# CWOS_V2_OPERATOR_STEP_UP_VERIFIED=1

# --- Runtime mode ------------------------------------------------------------

# NODE_ENV=production

# --- Live model (D7) ---------------------------------------------------------
#
# See docs/ops/live-model.md for the full contract. Default (unset) is
# offline/fail-closed: natural-command inference throws MODEL_UNAVAILABLE.
# Setting MODEL_PROVIDER=azure or openai_compatible wires a REAL Azure
# OpenAI (or OpenAI-compatible) ModelClient into createApp(), hardened with
# retry+backoff, an in-process circuit breaker, and a per-request timeout
# (streaming is opt-in via AZURE_OPENAI_STREAM below). Any other non-empty
# value makes createApp() throw at boot instead of silently falling back to
# offline.
# MODEL_PROVIDER=azure

# Required only when MODEL_PROVIDER is azure/openai_compatible. Real Azure
# resource base URL, or an OpenAI-compatible gateway base URL (e.g. a
# `.../v1` endpoint). Never commit a real value.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=CHANGE_ME

# api-key (default, real Azure REST) | openai_compatible (Bearer auth,
# POST {endpoint}/chat/completions) | azure_ad (Bearer auth, Azure URL shape).
# AZURE_OPENAI_AUTH_MODE=api-key

# Azure deployment name, or the model id for an OpenAI-compatible gateway.
# Defaults to kr/claude-haiku-4.5 if unset — set explicitly outside the pilot.
# AZURE_OPENAI_DEPLOYMENT=kr/claude-haiku-4.5

# Only used for the real Azure REST shape. Defaults to 2024-08-01-preview.
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Set to 1 ONLY when the deployment is contractually known (out of band) to
# honor zero-data-retention; otherwise the client honestly reports
# retentionHonored: false rather than fabricating a zero-retention claim.
# AZURE_OPENAI_ASSUME_ZERO_RETENTION=1

# Resilience (D7 gap closer PG-E): retry-with-backoff, in-process circuit
# breaker, and per-request timeout on the real client path only (offline/mock
# default is unaffected). Streaming is opt-in and thin — see
# docs/ops/live-model.md "Resilience" section for the honest scope.
# AZURE_OPENAI_MAX_RETRIES=3
# AZURE_OPENAI_RETRY_BASE_DELAY_MS=300
# AZURE_OPENAI_TIMEOUT_MS=30000
# AZURE_OPENAI_CIRCUIT_BREAKER_THRESHOLD=5
# AZURE_OPENAI_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# AZURE_OPENAI_STREAM=1

# --- Finance pack (S3) ------------------------------------------------------

# Dev-only bypass to boot with an UNSIGNED finance pack. MUST NOT be set in
# production — see docs/ops/finance-pack-pilot.md and the prod-mode test in
# apps/api/test/prod-auth.integration.test.ts.
# DEV_UNSIGNED_FINANCE_PACK=1

# --- Company memory donor (apps/worker, opt-in) ------------------------------
#
# Absent = disabled. Incomplete or unknown COMPANY_MEMORY_* fails closed and
# the worker refuses to start. Command must be an absolute `sb-company` path
# (never personal `sb`). Do not point this at live loopback API :4311, a
# personal vault, or production company SQLite. Signing key + authority files
# are operator-provisioned; CRM does not mint a shared key. When DATABASE_URL
# is set, the donor tick reads cwos_v2_mail_outbox (fail closed if missing).
# COMPANY_MEMORY_SB_COMPANY=/absolute/path/to/sb-company
# COMPANY_MEMORY_SB_COMPANY_CONFIG=/absolute/path/to/sb-company-config.json
# COMPANY_MEMORY_SIGNING_KEY_FILE=/absolute/path/to/donor-ed25519.pem
# COMPANY_MEMORY_AUTHORITY_FILE=/absolute/path/to/donor-authority.json

# --- Web (apps/web) ----------------------------------------------------------
# See apps/web/.env.example for the Next.js app's own template.

# Production is fail-closed: with NODE_ENV=production and no AUTH_API_KEY the API refuses
# to start ([AUTH_REQUIRED_IN_PROD]). Only set ALLOW_INSECURE_PROD=1 for an audited insecure bring-up.
# ALLOW_INSECURE_PROD=1

# Customer Work OS v2 web readiness (server-side only)
API_BASE_URL=http://localhost:3001
WORKSPACE_ID=
OPERATOR_PRINCIPAL_ID=
# Optional when the API is protected by AUTH_API_KEY/API_AUTH_TOKEN.
API_AUTH_TOKEN=
