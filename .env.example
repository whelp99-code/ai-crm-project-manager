# AI-CRM+Project Manager — root env template (apps/api, apps/worker)
#
# Copy to `.env` for local use; never commit real values. See
# docs/ops/runtime-dsn.md for the full runtime-role DSN contract and
# docs/ops/authn.md / docs/ops/finance-pack-pilot.md for the auth/finance
# fail-closed contracts these values gate.

# --- Database (G-01/G-05 role separation) ---------------------------------

# Runtime-role DSN: the connection the request path uses for scoped
# per-workspace reads/writes (RLS-enforced via `SET LOCAL app.workspace_id`).
# MUST point at the `ai_crm_runtime_api` role, which is NOBYPASSRLS — see
# packages/persistence/scripts/pg-rls-smoke.sh, which proves this role's
# workspace isolation live against the docker `ai_crm` database.
# DATABASE_URL=postgres://ai_crm_runtime_api:CHANGE_ME@localhost:5432/ai_crm

# Admin DSN (G-01 MEDIUM 4 role separation): used ONLY for hydrate-on-boot
# cross-workspace admin reads (listAllControls / listAllIntents /
# listJobSnapshots()) in apps/api, and for the same cross-workspace admin
# reads/writes (listAllControls / listAllIntents / outbox drain) plus
# scoping apps/worker's DATABASE_URL to per-workspace saveIntent only — see
# docs/ops/worker.md. This role legitimately bypasses RLS by design — point
# it at a role such as `ai_crm` (superuser/bootstrap) or a dedicated admin
# role, never the per-request runtime pool's own credentials. Falls back to
# DATABASE_URL when unset (dev-only fallback; see docs/ops/sor-persistence.md
# and docs/ops/worker.md).
# ADMIN_DATABASE_URL=postgres://ai_crm:CHANGE_ME@localhost:5432/ai_crm

# --- Auth (T-017 / G-05 fail-closed) ---------------------------------------

# Shared API key required on mutating /api/* and all /api/agent/* routes.
# Production MUST set one of AUTH_API_KEY / API_AUTH_TOKEN — see
# docs/ops/runtime-dsn.md and docs/ops/authn.md. Leaving both unset outside
# production keeps the existing dev header-principal mode.
# AUTH_API_KEY=CHANGE_ME
# API_AUTH_TOKEN=CHANGE_ME

# --- Runtime mode ------------------------------------------------------------

# NODE_ENV=production

# --- Live model (D7) ---------------------------------------------------------
#
# See docs/ops/live-model.md for the full contract. Default (unset) is
# offline/fail-closed: natural-command inference throws MODEL_UNAVAILABLE.
# Setting MODEL_PROVIDER=azure or openai_compatible wires a REAL Azure
# OpenAI (or OpenAI-compatible) ModelClient into createApp() — single
# deterministic call, no streaming/retries/circuit-breaker yet. Any other
# non-empty value makes createApp() throw at boot instead of silently
# falling back to offline.
# MODEL_PROVIDER=azure

# Required only when MODEL_PROVIDER is azure/openai_compatible. Real Azure
# resource base URL, or an OpenAI-compatible gateway base URL (e.g. a
# `.../v1` endpoint). Never commit a real value.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=CHANGE_ME

# api-key (default, real Azure REST) | openai_compatible (Bearer auth,
# POST {endpoint}/chat/completions) | azure_ad (Bearer auth, Azure URL shape).
# AZURE_OPENAI_AUTH_MODE=api-key

# Azure deployment name, or the model id for an OpenAI-compatible gateway.
# Defaults to kr/claude-haiku-4.5 if unset — set explicitly outside the pilot.
# AZURE_OPENAI_DEPLOYMENT=kr/claude-haiku-4.5

# Only used for the real Azure REST shape. Defaults to 2024-08-01-preview.
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Set to 1 ONLY when the deployment is contractually known (out of band) to
# honor zero-data-retention; otherwise the client honestly reports
# retentionHonored: false rather than fabricating a zero-retention claim.
# AZURE_OPENAI_ASSUME_ZERO_RETENTION=1

# --- Finance pack (S3) ------------------------------------------------------

# Dev-only bypass to boot with an UNSIGNED finance pack. MUST NOT be set in
# production — see docs/ops/finance-pack-pilot.md and the prod-mode test in
# apps/api/test/prod-auth.integration.test.ts.
# DEV_UNSIGNED_FINANCE_PACK=1

# --- Web (apps/web) ----------------------------------------------------------
# See apps/web/.env.example for the Next.js app's own template.

# Production is fail-closed: with NODE_ENV=production and no AUTH_API_KEY the API refuses
# to start ([AUTH_REQUIRED_IN_PROD]). Only set ALLOW_INSECURE_PROD=1 for an audited insecure bring-up.
# ALLOW_INSECURE_PROD=1
