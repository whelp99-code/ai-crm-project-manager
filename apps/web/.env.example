# apps/web (Next.js) — env template.
#
# Copy to `.env.local` for local use; never commit real values. All server
# components fail closed (render an "unavailable" panel) when these are
# unset — see apps/web/app/page.tsx, work/page.tsx, approvals/page.tsx,
# monitor/page.tsx and docs/ops/runtime-dsn.md.

# Base URL of the running apps/api instance this web app reads/writes
# through. Mutations only ever go through POST /api/agent/commands; reads use
# workspace-scoped GET routes and (monitor page) read-only GET /metrics.
# API_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Tenant binding sent as x-workspace-id on every request.
# WORKSPACE_ID=ws-demo
# NEXT_PUBLIC_WORKSPACE_ID=ws-demo

# Demo customer id used by the 360 overview page (apps/web/app/page.tsx).
# DEMO_CUSTOMER_ID=customer-demo-1

# Optional operator/approver principal defaults (fall back to "operator-1" /
# "approver-1" when unset).
# OPERATOR_PRINCIPAL_ID=operator-1
# NEXT_PUBLIC_OPERATOR_PRINCIPAL_ID=operator-1
# APPROVER_PRINCIPAL_ID=approver-1
# NEXT_PUBLIC_APPROVER_PRINCIPAL_ID=approver-1
